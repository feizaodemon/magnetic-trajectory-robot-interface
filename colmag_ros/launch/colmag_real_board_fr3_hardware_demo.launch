<launch>
  <!-- Lab-only real-board-ready route. board_source defaults mock; serial and
       real motion each require separate explicit operator choices. -->
  <arg name="robot_ip" />
  <arg name="arm_id" default="fr3" />
  <arg name="board_source" default="mock" />
  <arg name="port" default="" />
  <arg name="baudrate" default="921600" />
  <arg name="send_goals" default="false" />
  <arg name="hardware_execution_enabled" default="false" />
  <arg name="hardware_profile" default="dry-run" />
  <arg name="realtime_config" default="enforce" />
  <arg name="joint_nudge_delta_rad" default="0.10" />
  <arg name="one_shot_hardware_mode" default="true" />
  <arg name="max_motion_goals_per_process" default="1" />
  <arg name="execution_timeout_sec" default="15.0" />
  <arg name="allowed_tasks" default="MOVE_LEFT, HEXAGON_TRAJECTORY, MOVE_RIGHT, STOP_OR_CANCEL" />

  <include file="$(find colmag_ros)/launch/colmag_real_board_fr3_adapter_dry_run.launch">
    <arg name="board_source" value="$(arg board_source)" />
    <arg name="port" value="$(arg port)" />
    <arg name="baudrate" value="$(arg baudrate)" />
    <arg name="start_adapter" value="false" />
    <arg name="safety_badge" value="REAL FR3 LAB ROUTE / EXPLICIT BOARD AND MOTION GATES" />
    <arg name="footer_text" value="COLMAG real-board dashboard | dwell confirm -> Strategy A | real FR3 lab" />
  </include>

  <include file="$(find colmag_ros)/launch/colmag_fr3_hardware_stack.launch">
    <arg name="robot_ip" value="$(arg robot_ip)" />
    <arg name="arm_id" value="$(arg arm_id)" />
    <arg name="send_goals" value="$(arg send_goals)" />
    <arg name="hardware_execution_enabled" value="$(arg hardware_execution_enabled)" />
    <arg name="hardware_profile" value="$(arg hardware_profile)" />
    <arg name="realtime_config" value="$(arg realtime_config)" />
    <arg name="joint_nudge_delta_rad" value="$(arg joint_nudge_delta_rad)" />
    <arg name="one_shot_hardware_mode" value="$(arg one_shot_hardware_mode)" />
    <arg name="max_motion_goals_per_process" value="$(arg max_motion_goals_per_process)" />
    <arg name="execution_timeout_sec" value="$(arg execution_timeout_sec)" />
    <arg name="allowed_tasks" value="$(arg allowed_tasks)" />
  </include>
</launch>
