<launch>
  <!--
    Keyboard Cartesian -> shared Cartesian core -> Gazebo Panda robot-body route.

    Terminal 1 starts this backend/dispatcher launch. Terminal 2 runs
    keyboard_teleop_node.py with rosrun so the node owns an interactive stdin.
    The GUI/DTW TASK frontend and continuous Cartesian adapter coexist behind
    the shared TASK/TELEOP seam. TASK remains the startup default. Run
    keyboard_cartesian_teleop_node.py separately so it owns stdin.

    Gazebo only: this launch has no FR3 hardware stack, robot_ip, serial input,
    or real-robot command path.
  -->
  <arg name="start_franka_gazebo" default="true" />
  <arg name="headless" default="false" />
  <arg name="paused" default="false" />
  <arg name="rviz" default="false" />
  <arg name="confirmed_topic" default="/colmag/teleop/confirmed_label" />
  <arg name="cartesian_input_topic" default="/colmag/teleop/cartesian_input" />
  <arg name="task_command_topic" default="/colmag/task_command" />

  <include file="$(find colmag_ros)/launch/final_gazebo_robot_demo.launch">
    <arg name="start_dtw_frontend" value="true" />
    <arg name="start_cartesian_teleop" value="true" />
    <arg name="start_keyboard_teleop" value="false" />
    <arg name="start_franka_gazebo" value="$(arg start_franka_gazebo)" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="task_command_topic" value="$(arg task_command_topic)" />
    <arg name="keyboard_confirmed_topic" value="$(arg confirmed_topic)" />
    <arg name="cartesian_input_topic" value="$(arg cartesian_input_topic)" />
  </include>
</launch>
