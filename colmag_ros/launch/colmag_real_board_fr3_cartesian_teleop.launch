<launch>
  <!--
    Unified Real-FR3 backend profile. Recognition-driven TASK execution and
    magnetic-board continuous TELEOP remain present across GUI mode changes.
    Physical acquisition, controller bringup, discrete goals, continuous
    commands, and calibration remain independent launch gates.
  -->
  <arg name="robot_ip" default="" />
  <arg name="arm_id" default="fr3" />
  <arg name="board_source" default="none" doc="none | mock | replay | serial" />
  <arg name="port" default="" />
  <arg name="baudrate" default="921600" />
  <arg name="project_src_path" default="$(find colmag_ros)/../src" />
  <arg name="replay_sequence_id" default="1" />
  <arg name="replay_loop" default="false" />

  <arg name="bank_path"
       default="$(find colmag_ros)/config/dtw_banks/m104c1_8symbol_mouse_seeded_yflip.json" />
  <arg name="real_board_demo_allowed_labels" default="1,2,3,V,O,C" />
  <arg name="min_confidence" default="0.25" />
  <arg name="dispatcher_mapping_name" default="m104c4_8symbol_gazebo" />
  <arg name="allowed_tasks"
       default="MOVE_LEFT, HEXAGON_TRAJECTORY, MOVE_RIGHT, STOP_OR_CANCEL" />

  <arg name="raw_packet_topic" default="/colmag/raw_packet" />
  <arg name="trajectory_topic" default="/colmag/trajectory_2d" />
  <arg name="confirmed_topic" default="/colmag/confirmed_label" />
  <arg name="task_command_topic" default="/colmag/task_command" />
  <arg name="joint_state_topic" default="/franka_state_controller/joint_states" />
  <arg name="controller_name" default="position_joint_trajectory_controller" />
  <arg name="follow_joint_trajectory_action"
       default="/$(arg controller_name)/follow_joint_trajectory" />
  <arg name="command_topic" default="/$(arg controller_name)/command" />
  <arg name="task_state_topic" default="/colmag/fr3_task_trajectory_adapter_state" />
  <arg name="teleop_state_topic" default="/colmag/fr3_cartesian_teleop_state" />
  <arg name="control_mode_topic" default="/colmag/control_mode" />
  <arg name="control_mode_request_topic" default="/colmag/control_mode/request" />
  <arg name="initial_mode" default="TASK" />

  <arg name="start_fr3_hardware" default="false" />
  <arg name="allow_real_robot" default="false" />
  <arg name="send_goals" default="false" />
  <arg name="send_commands" default="false" />
  <arg name="hardware_profile" default="dry-run" />
  <arg name="calibration_valid" default="false" />
  <arg name="realtime_config" default="enforce" />
  <arg name="one_shot_hardware_mode" default="true" />
  <arg name="max_motion_goals_per_process" default="1" />
  <arg name="execution_timeout_sec" default="15.0" />
  <arg name="teleop_config_file"
       default="$(find colmag_ros)/config/colmag_fr3_cartesian_teleop.yaml" />

  <node pkg="colmag_ros" type="control_mode_node.py"
        name="control_mode_node" output="screen">
    <param name="state_topic" value="$(arg control_mode_topic)" />
    <param name="request_topic" value="$(arg control_mode_request_topic)" />
    <param name="initial_mode" value="$(arg initial_mode)" />
  </node>

  <!-- One board acquisition/dashboard/recognition closure. The dispatcher is
       TASK-gated and non-latched so returning to TASK requires a future confirm. -->
  <include file="$(find colmag_ros)/launch/dtw_real_board_demo_frontend.launch">
    <arg name="board_source" value="$(arg board_source)" />
    <arg name="port" value="$(arg port)" />
    <arg name="baudrate" value="$(arg baudrate)" />
    <arg name="project_src_path" value="$(arg project_src_path)" />
    <arg name="replay_sequence_id" value="$(arg replay_sequence_id)" />
    <arg name="replay_loop" value="$(arg replay_loop)" />
    <arg name="raw_packet_topic" value="$(arg raw_packet_topic)" />
    <arg name="trajectory_topic" value="$(arg trajectory_topic)" />
    <arg name="confirmed_topic" value="$(arg confirmed_topic)" />
    <arg name="task_command_topic" value="$(arg task_command_topic)" />
    <arg name="bank_path" value="$(arg bank_path)" />
    <arg name="real_board_demo_allowed_labels" value="$(arg real_board_demo_allowed_labels)" />
    <arg name="dtw_template_allowed_labels" value="$(arg real_board_demo_allowed_labels)" />
    <arg name="label_set" value="$(arg real_board_demo_allowed_labels)" />
    <arg name="dashboard_candidate_labels" value="$(arg real_board_demo_allowed_labels)" />
    <arg name="min_confidence" value="$(arg min_confidence)" />
    <arg name="dispatcher_mapping_name" value="$(arg dispatcher_mapping_name)" />
    <arg name="dispatcher_gazebo_only" value="false" />
    <arg name="enable_task_dispatch" value="true" />
    <arg name="latch_task_command" value="false" />
    <arg name="control_mode_enabled" value="true" />
    <arg name="control_mode_topic" value="$(arg control_mode_topic)" />
    <arg name="control_mode_request_topic" value="$(arg control_mode_request_topic)" />
    <arg name="required_control_mode" value="TASK" />
    <arg name="safety_badge" value="REAL FR3 PROFILE / HARDWARE GATES INDEPENDENT" />
    <arg name="footer_text" value="TASK: confirm to discrete adapter | TELEOP: board to continuous Cartesian core" />
  </include>

  <group if="$(arg start_fr3_hardware)">
    <include file="$(find colmag_ros)/launch/colmag_fr3_hardware_bringup.launch">
      <arg name="robot_ip" value="$(arg robot_ip)" />
      <arg name="arm_id" value="$(arg arm_id)" />
      <arg name="controller_name" value="$(arg controller_name)" />
      <arg name="realtime_config" value="$(arg realtime_config)" />
      <arg name="start_controller" value="true" />
    </include>
  </group>

  <!-- Discrete TASK owner. Mode transition cancellation is adapter-owned and
       uses the existing FollowJointTrajectory action client lifecycle. -->
  <include file="$(find colmag_ros)/launch/m104r1c_fr3_task_trajectory_adapter_static_entrypoint.launch">
    <arg name="arm_id" value="$(arg arm_id)" />
    <arg name="command_topic" value="$(arg task_command_topic)" />
    <arg name="state_topic" value="$(arg task_state_topic)" />
    <arg name="controller_name" value="$(arg controller_name)" />
    <arg name="follow_joint_trajectory_action" value="$(arg follow_joint_trajectory_action)" />
    <arg name="controller_joint_names_param" value="/$(arg controller_name)/joints" />
    <arg name="joint_state_topic" value="$(arg joint_state_topic)" />
    <arg name="send_goals" value="$(arg send_goals)" />
    <arg name="hardware_execution_enabled" value="$(arg allow_real_robot)" />
    <arg name="hardware_profile" value="$(arg hardware_profile)" />
    <arg name="one_shot_hardware_mode" value="$(arg one_shot_hardware_mode)" />
    <arg name="max_motion_goals_per_process" value="$(arg max_motion_goals_per_process)" />
    <arg name="execution_timeout_sec" value="$(arg execution_timeout_sec)" />
    <arg name="allowed_tasks" value="$(arg allowed_tasks)" />
    <arg name="control_mode_topic" value="$(arg control_mode_topic)" />
    <arg name="required_control_mode" value="TASK" />
  </include>

  <!-- Continuous TELEOP owner. It shares the controller but cannot publish in
       TASK, cannot use a pre-transition input/joint sample, and retains the
       complete default-off physical gate. -->
  <node pkg="colmag_ros" type="colmag_fr3_cartesian_teleop_adapter"
        name="colmag_fr3_cartesian_teleop_adapter" output="screen">
    <rosparam command="load" file="$(arg teleop_config_file)" />
    <param name="input_mode" value="magnetic_board" />
    <param name="arm_id" value="$(arg arm_id)" />
    <param name="trajectory_topic" value="$(arg trajectory_topic)" />
    <param name="joint_state_topic" value="$(arg joint_state_topic)" />
    <param name="control_mode_topic" value="$(arg control_mode_topic)" />
    <param name="command_topic" value="$(arg command_topic)" />
    <param name="state_topic" value="$(arg teleop_state_topic)" />
    <param name="simulation_commands_enabled" value="false" />
    <param name="allow_real_robot" value="$(arg allow_real_robot)" />
    <param name="send_commands" value="$(arg send_commands)" />
    <param name="hardware_bringup_enabled" value="$(arg start_fr3_hardware)" />
    <param name="hardware_profile" value="$(arg hardware_profile)" />
    <param name="calibration_valid" value="$(arg calibration_valid)" />
  </node>
</launch>
