<launch>
  <!-- Official mouse/no-board -> Strategy A FR3 adapter dry-run.
       This launch never starts Gazebo, serial, controller_manager, or hardware.
       send_goals is fixed false; the adapter can report commands but cannot move
       a real robot. -->

  <arg name="bank_path"
       default="$(find colmag_ros)/config/dtw_banks/m104c1_8symbol_mouse_seeded_yflip.json" />
  <arg name="dtw_template_allowed_labels" default="1,2,3,V,O,X,A,C" />
  <arg name="label_set" default="1,2,3,V,O,X,A,C" />
  <arg name="dispatcher_mapping_name" default="m104c4_8symbol_gazebo" />
  <arg name="min_confidence" default="0.25" />
  <arg name="follow_joint_trajectory_action"
       default="/position_joint_trajectory_controller/follow_joint_trajectory" />
  <arg name="joint_state_topic" default="/franka_state_controller/joint_states" />
  <arg name="arm_id" default="fr3" />
  <arg name="joint_names"
       default="$(arg arm_id)_joint1, $(arg arm_id)_joint2, $(arg arm_id)_joint3, $(arg arm_id)_joint4, $(arg arm_id)_joint5, $(arg arm_id)_joint6, $(arg arm_id)_joint7" />
  <arg name="start_adapter" default="true" />
  <arg name="safety_badge" default="FR3 ADAPTER DRY-RUN / SEND_GOALS=FALSE" />
  <arg name="footer_text" default="COLMAG trajectory dashboard | dwell confirm -> task_dispatcher | FR3 adapter dry-run" />
  <arg name="route_scope_text" default="FR3 adapter dry-run. No real robot goal." />

  <include file="$(find colmag_ros)/launch/dtw_mouse_demo_frontend.launch">
    <arg name="enable_task_dispatch" value="false" />
    <arg name="require_manual_confirm" value="true" />
    <arg name="recognizer_backend" value="dtw_template_bank" />
    <arg name="dtw_template_bank_path" value="$(arg bank_path)" />
    <arg name="dtw_template_allowed_labels" value="$(arg dtw_template_allowed_labels)" />
    <arg name="label_set" value="$(arg label_set)" />
    <arg name="dispatcher_mapping_name" value="$(arg dispatcher_mapping_name)" />
    <arg name="min_confidence" value="$(arg min_confidence)" />
    <arg name="publish_task_command" value="false" />
    <arg name="dashboard_controller_layout" value="rank_confirm" />
    <arg name="dashboard_gamepad_enabled" value="false" />
    <arg name="dashboard_candidate_labels" value="$(arg label_set)" />
    <arg name="safety_badge" value="$(arg safety_badge)" />
    <arg name="footer_text" value="$(arg footer_text)" />
    <arg name="route_scope_text" value="$(arg route_scope_text)" />
  </include>

  <node pkg="colmag_ros" type="task_dispatcher_node.py"
        name="task_dispatcher_node" output="screen">
    <param name="confirmed_label_topic" value="/colmag/confirmed_label" />
    <param name="task_command_topic" value="/colmag/task_command" />
    <param name="min_confidence" value="$(arg min_confidence)" />
    <param name="gazebo_only" value="false" />
    <param name="dispatcher_mapping_name" value="$(arg dispatcher_mapping_name)" />
    <param name="allowed_task_set" value="safe_gazebo_demo" />
    <param name="allow_critical_tasks" value="false" />
  </node>

  <group if="$(arg start_adapter)">
    <include file="$(find colmag_ros)/launch/m104r1c_fr3_task_trajectory_adapter_static_entrypoint.launch">
      <arg name="send_goals" value="false" />
      <arg name="arm_id" value="$(arg arm_id)" />
      <arg name="follow_joint_trajectory_action" value="$(arg follow_joint_trajectory_action)" />
      <arg name="joint_state_topic" value="$(arg joint_state_topic)" />
      <arg name="joint_names" value="$(arg joint_names)" />
      <arg name="reject_gazebo_only_commands" value="true" />
      <arg name="reject_controls_real_robot_true" value="true" />
    </include>
  </group>
</launch>
