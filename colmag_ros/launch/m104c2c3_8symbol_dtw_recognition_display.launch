<launch>
  <!--
    COLMAG M104-C2C3 - 8-symbol DTW recognition display and display-only
    semantic mapping plan.

    Route:
      mouse dashboard (ocr_canvas)
        -> /colmag/symbol_capture
        -> trajectory_symbol_top3_recognizer_node.py via the B2e recognizer-only
           dtw_template_bank wrapper
        -> /colmag/symbol_candidates
        -> dashboard top-3 display with display-only future intent names

    This launch is recognition/display only. It does not start
    task_dispatcher_node.py, fr3_gazebo_visible_task_bridge_node.py,
    gazebo_task_executor.py, candidate_panel_node.py, auto-confirm, Gazebo, or
    any robot / real-FR3 route. The dashboard is started with confirm publishing
    disabled and publish_task_command=false.
  -->

  <arg name="symbol_capture_topic" default="/colmag/symbol_capture" />
  <arg name="symbol_candidates_topic" default="/colmag/symbol_candidates" />
  <arg name="recognized_label_topic" default="/colmag/recognized_label" />

  <arg name="dtw_template_bank_path"
       default="$(find colmag_ros)/config/dtw_banks/m104c1_8symbol_mouse_seeded_yflip.json" />
  <arg name="dtw_template_allowed_labels" default="1,2,3,V,O,X,A,C" />
  <arg name="dtw_template_top_k" default="3" />
  <arg name="dtw_template_max_distance" default="0.12" />
  <arg name="dtw_template_min_margin" default="0.01" />
  <arg name="dtw_template_min_confidence" default="0.30" />
  <arg name="label_set" default="1,2,3,V,O,X,A,C" />
  <arg name="min_confidence" default="0.0" />

  <include file="$(find colmag_ros)/launch/m104b2d_dtw_template_bank_mouse_smoke.launch">
    <arg name="symbol_capture_topic" value="$(arg symbol_capture_topic)" />
    <arg name="symbol_candidates_topic" value="$(arg symbol_candidates_topic)" />
    <arg name="recognized_label_topic" value="$(arg recognized_label_topic)" />
    <arg name="recognizer_backend" value="dtw_template_bank" />
    <arg name="dtw_template_bank_path" value="$(arg dtw_template_bank_path)" />
    <arg name="dtw_template_allowed_labels" value="$(arg dtw_template_allowed_labels)" />
    <arg name="dtw_template_top_k" value="$(arg dtw_template_top_k)" />
    <arg name="dtw_template_max_distance" value="$(arg dtw_template_max_distance)" />
    <arg name="dtw_template_min_margin" value="$(arg dtw_template_min_margin)" />
    <arg name="dtw_template_min_confidence" value="$(arg dtw_template_min_confidence)" />
    <arg name="label_set" value="$(arg label_set)" />
    <arg name="min_confidence" value="$(arg min_confidence)" />
  </include>

  <node pkg="colmag_ros"
        type="magnetic_trajectory_dashboard_node.py"
        name="m104c2c3_recognition_display_dashboard"
        output="screen">
    <param name="demo_input_mode" value="ocr_canvas" />
    <param name="symbol_capture_topic" value="$(arg symbol_capture_topic)" />
    <param name="symbol_candidates_topic" value="$(arg symbol_candidates_topic)" />
    <param name="integrated_dashboard_confirm_enabled" value="false" />
    <param name="publish_confirmed_label" value="false" />
    <param name="publish_task_command" value="false" />
    <param name="dashboard_gamepad_enabled" value="false" />
    <param name="dashboard_virtual_buttons_enabled" value="false" />
    <param name="safety_badge" value="RECOGNITION DISPLAY ONLY / NO ROBOT EXECUTION" />
    <param name="footer_text" value="M104-C2C3 8-symbol display | dtw_template_bank -> /colmag/symbol_candidates | display-only semantic plan" />
  </node>
</launch>
