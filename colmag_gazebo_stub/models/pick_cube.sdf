<?xml version="1.0"?>
<!-- 5 cm cube for the Gazebo TELEOP pick-and-place demo. -->
<sdf version="1.6">
  <model name="pick_cube">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2.1e-5</ixx><iyy>2.1e-5</iyy><izz>2.1e-5</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <surface>
          <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          <contact><ode><kp>1000000</kp><kd>100</kd><min_depth>0.001</min_depth><max_vel>0.1</max_vel></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <material><ambient>0.31 0.27 0.90 1</ambient><diffuse>0.31 0.27 0.90 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
