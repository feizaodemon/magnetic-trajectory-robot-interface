<?xml version="1.0"?>
<!-- Flat static target pad for the Gazebo TELEOP pick-and-place demo. -->
<sdf version="1.6">
  <model name="place_pad">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.12 0.12 0.004</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.12 0.12 0.004</size></box></geometry>
        <material><ambient>0.09 0.64 0.29 1</ambient><diffuse>0.09 0.64 0.29 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
