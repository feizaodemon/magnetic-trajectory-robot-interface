# Copy to docker/fr3-hardware.env (ignored) and fill on the isolated lab host.
COLMAG_FR3_DOCKER_IMAGE=magnetic-trajectory-interface:fr3-noetic
FR3_ROBOT_IP=
ROS_MASTER_URI=http://localhost:11311
COLMAG_HARDWARE_EXECUTION_ENABLED=false
COLMAG_SEND_GOALS=false
# Continuous Mouse/board demo; Compose falls back to one-shot when omitted.
COLMAG_MAX_MOTION_GOALS_PER_PROCESS=0
COLMAG_GIT_SHA=uncommitted
# Optional host Xauthority file for the Mouse/board dashboard profiles.
COLMAG_XAUTHORITY=
# Host serial device for the real magnetic board profile only.
# Prefer a /dev/serial/by-id/* path; empty keeps the /dev/ttyACM0 default.
COLMAG_BOARD_DEVICE=
